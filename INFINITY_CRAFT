<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elementum — Бесконечный Крафт</title>
    <style>
        :root {
            --bg-color: #121214;
            --sidebar-bg: #1a1a1e;
            --text-color: #e1e1e6;
            --accent-color: #4a90e2;
            --border-color: #29292e;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
        }

        body {
            display: flex;
            height: 100vh;
            background-color: var(--bg-color);
            color: var(--text-color);
            overflow: hidden;
        }

        /* Игровая зона */
        #craft-zone {
            flex: 1;
            position: relative;
            background-image: radial-gradient(var(--border-color) 1px, transparent 0);
            background-size: 24px 24px;
            overflow: hidden;
        }

        /* Боковая панель элементов */
        #sidebar {
            width: 320px;
            background-color: var(--sidebar-bg);
            border-left: 2px solid var(--border-color);
            display: flex;
            flex-direction: column;
        }

        .panel-header {
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .game-title {
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--accent-color);
        }

        #element-list {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-content: flex-start;
        }

        /* Стили элементов */
        .element {
            display: inline-flex;
            align-items: center;
            padding: 8px 14px;
            background: #202024;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .element:hover {
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }

        .board-element {
            position: absolute;
            position: absolute;
            z-index: 10;
            touch-action: none;
        }

        /* Интерфейс управления */
        .controls {
            padding: 15px;
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 10px;
        }

        button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 6px;
            background-color: #29292e;
            color: white;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }

        button:hover {
            background-color: #38383f;
        }

        button.primary {
            background-color: var(--accent-color);
        }

        button.primary:hover {
            background-color: #357abd;
        }

        /* Модальное окно авторизации */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 100;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: var(--sidebar-bg);
            padding: 30px;
            border-radius: 12px;
            width: 360px;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .modal-content h3 {
            text-align: center;
            margin-bottom: 10px;
        }

        .modal-content input {
            padding: 10px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: #121214;
            color: white;
        }
    </style>
</head>
<body>

    <!-- Игровая доска -->
    <div id="craft-zone"></div>

    <!-- Боковое меню -->
    <div id="sidebar">
        <div class="panel-header">
            <div class="game-title">🧪 Elementum</div>
            <button id="auth-status-btn" onclick="openAuthModal()" style="max-width: fit-content; padding: 5px 10px; font-size: 0.8rem;">Войти</button>
        </div>
        
        <!-- Список открытых элементов -->
        <div id="element-list"></div>

        <!-- Кнопки управления -->
        <div class="controls">
            <button onclick="clearBoard()">🧹 Очистить поле</button>
            <button class="primary" onclick="resetProgress()">🔄 Сброс</button>
        </div>
    </div>

    <!-- Окно авторизации -->
    <div id="auth-modal" class="modal">
        <div class="modal-content">
            <h3>Вход / Регистрация</h3>
            <input type="email" id="auth-email" placeholder="Email">
            <input type="password" id="auth-password" placeholder="Пароль">
            <button class="primary" onclick="handleEmailAuth(true)">Зарегистрироваться</button>
            <button onclick="handleEmailAuth(false)">Войти по Email</button>
            <hr style="border-color: var(--border-color)">
            <button onclick="handleGoogleAuth()" style="background: #db4437;">🔴 Войти через Google</button>
            <button onclick="closeAuthModal()" style="background: transparent; color: #888;">Отмена</button>
        </div>
    </div>

