        // Базовые элементы
        const BASE_ELEMENTS = [
            { id: 'water', name: '💧 Вода' },
            { id: 'fire', name: '🔥 Огонь' },
            { id: 'earth', name: '🌱 Земля' },
            { id: 'air', name: '💨 Воздух' }
        ];

        // Книга рецептов (СПОСОБЫ КРАФТА)
