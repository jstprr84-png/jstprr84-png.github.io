        // Состояние игры (открытые элементы у игрока)
        let unlockedElements = [...BASE_ELEMENTS];

        // Инициализация интерфейса
        window.initGame = () => {
            loadLocalProgress();
            renderSidebar();
        };

        function renderSidebar() {
            const list = document.getElementById('element-list');
            list.innerHTML = '';
            unlockedElements.forEach(el => {
                const div = document.createElement('div');
                div.className = 'element';
                div.innerText = el.name;
                div.onclick = (e) => spawnElement(el, e.clientX || 100, e.clientY || 100);
                list.appendChild(div);
            });
        }

