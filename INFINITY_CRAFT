            'air+fire': { id: 'energy', name: '⚡ Энергия' },
            'earth+fire': { id: 'lava', name: '🌋 Лава' },
            'air+earth': { id: 'dust', name: '⏳ Пыль' },
            'lava+water': { id: 'stone', name: '🪨 Камень' },
